# =============================================================================
# Backend configuration
#
#   1. Copy this file to backend/.env
#   2. Fill in the values marked REQUIRED
#   3. Never commit backend/.env (it holds secrets)
#
# REQUIRED IN PRODUCTION means the API refuses to start without it when
# NODE_ENV=production. Everything else is optional.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Use "production" when deployed (it makes missing settings fatal).
NODE_ENV=development

# Port the API listens on. The frontend dev server expects 5000.
PORT=5000

# REQUIRED IN PRODUCTION. Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# Maximum JSON request body size.
JSON_LIMIT=1mb


# -----------------------------------------------------------------------------
# Database (Postgres on Supabase)
# -----------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Postgres connection string.
#
# Supabase: Dashboard -> your project -> Project Settings -> Database ->
# Connection string. Use the "Session pooler" URI (works everywhere, including
# IPv4-only networks). It looks like:
#   postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If your password contains special characters (@ : / # ?), URL-encode them.
#
# Apply the schema once before first use: supabase db push, or run the files in
# supabase/migrations/ (in order) in the Supabase SQL editor. Then load the
# official datasets: node backend/scripts/loadReferenceData.js
#
# Local development with nothing to install: an in-process Postgres that applies
# the migrations by itself and keeps its data in backend/.data/ (not for production):
#   DATABASE_URL=pglite:./.data/dev-db      (persistent)
#   DATABASE_URL=pglite:memory              (throwaway, lost on restart)
DATABASE_URL=pglite:./.data/dev-db

# Optional. Path to the Supabase CA certificate (Project Settings -> Database ->
# SSL Configuration) so the server certificate is verified. Without it the
# connection is encrypted but the certificate is not checked. Recommended.
DATABASE_SSL_CA=

# Optional. Set to "disable" to turn TLS off (only for a Postgres you run yourself).
DATABASE_SSL=

# Optional. Maximum connections in the pool (default 10).
DATABASE_POOL_MAX=10


# -----------------------------------------------------------------------------
# Authentication (Supabase Auth)
# -----------------------------------------------------------------------------

# Sign-up, sign-in (email + Google) and password-reset emails are all handled by
# Supabase Auth. The backend only checks the session token with Supabase.
# Both values are public: Dashboard > Project Settings > API (the publishable key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# To set up in the Supabase dashboard (Authentication):
#  - URL Configuration: Site URL = your frontend, Redirect URLs include
#    <frontend>/oauth/google/callback and <frontend>/reset-password
#  - Providers > Google: enable it with your Google OAuth client id and secret, and add
#    https://<project-ref>.supabase.co/auth/v1/callback as an authorised redirect URI in Google Cloud
#  - Emails > SMTP: use Resend (host smtp.resend.com, port 465, user "resend",
#    password = your Resend API key, sender on a domain verified in Resend)
#  - Sign In / Providers: allow manual linking so users can connect Google to a password account


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# All endpoints, per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Stricter limit for login, signup and password-reset endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Per-user budget for AI requests.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30


# -----------------------------------------------------------------------------
# AI assistant: advisor, chat and crop suggestions
# -----------------------------------------------------------------------------
# The assistant runs inside this server (open-source models via node-llama-cpp). No API key, no external
# service, nothing leaves the machine. Install the model files once with:
#
#   cd backend && npm run models:download        (about 3 GB: chat model, embedding model, reranker)
#   python ../datasets/scripts/fetch_knowledge.py  (the official documents it reads; see datasets/knowledge/)
#
# Until the models are installed the AI features report that AI is not configured; everything else works.
# Everything below is optional.

# Chat model (hf:user/repo/file.gguf or a path to a .gguf file). Default: Qwen3-4B Q4_K_M (Apache-2.0).
# Qwen3-1.7B is about 1.8x faster but makes more mistakes: hf:Qwen/Qwen3-1.7B-GGUF/Qwen3-1.7B-Q8_0.gguf
LLM_MODEL_URI=

# Multilingual embedding model used to search the documents. Default: bge-m3 Q4_K_M (MIT).
EMBED_MODEL_URI=

# Reranker that picks the passages that really answer a question. Default: bge-reranker-v2-m3 (Apache-2.0).
# RERANK=off skips it: faster answers, worse sources.
RERANK_MODEL_URI=
RERANK=

# Where the model files live. Default: backend/.models
LLM_MODELS_DIR=

# CPU threads for the models. Default: logical cores minus 2, at most 8 (more was slower on a laptop CPU).
LLM_THREADS=

# Prompt size and answer length limits (tokens). Longer prompts take longer to read on a CPU.
LLM_CONTEXT_SIZE=4096
LLM_MAX_ANSWER_TOKENS=450
LLM_MAX_JSON_TOKENS=1000

# Use a GPU when the runtime finds one (LLM_GPU=auto). Default is CPU only.
LLM_GPU=

# AI_WARMUP=off stops the server loading the models and indexing the documents at start-up.
# AI_LOG_TIMING=1 logs where each chat request spends its time.
AI_WARMUP=
AI_LOG_TIMING=


# -----------------------------------------------------------------------------
# Data ingest (not used by the running server)
# -----------------------------------------------------------------------------

# Free key for the official mandi price API: sign in at https://data.gov.in ->
# My Account -> API key. Used by: node backend/scripts/ingestMandiPrices.js
# The source only publishes today's prices, so run that daily to build history.
DATA_GOV_IN_API_KEY=
