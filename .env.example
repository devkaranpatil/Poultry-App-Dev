# Website settings (Vite). Copy to .env, or let `npm start` do it. All values here are public: they end up
# in the browser.

# The API. Leave empty in development to use http://localhost:5000.
VITE_API_BASE_URL=

# Sign-in (Supabase Auth): Dashboard > Project Settings > API. The same project as SUPABASE_URL in backend/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
